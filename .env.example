# Copy to .env.local (never commit secrets).
# Documented path: `lk cloud auth` then `lk app env -w` in this folder.

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional — some CLI templates also write this; server accepts either URL var.
# NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
